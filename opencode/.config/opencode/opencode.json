{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "*.envrc.*": "deny",
      ".direnv/**": "deny",
      "env/**": "deny",
      "__pycache__/**": "deny",
      ".git/**": "deny",
      "**/.terragrunt-cache/**": "deny",
      "**/node_modules/**": "deny",
      "~/.aws/credentials": "deny",
      "~/.ssh/**": "deny",
      "~/.config/openstack/secure.y*ml": "deny",
      "~/.config/openstack/*.sh": "deny",
      "*.pem": "deny",
      "*.rsa": "deny",
      "*.ed25519": "deny",
      "*.gpg": "deny",
      "*.key": "deny"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git branch -v*": "allow",
      "git remote -v*": "allow",
      "git reflog*": "allow",
      "env *": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git pull*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git revert*": "deny",
      "git cherry-pick*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git stash *": "deny",
      "git tag *": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "git clean*": "deny",
      "git am*": "deny",
      "git apply*": "deny",
      "git config*": "deny",
      "git init*": "deny",
      "git clone*": "deny",
      "git stash list*": "allow"
    }
  },
  "provider": {},
  "watcher": {
    "ignore": [
      ".env",
      ".envrc",
      ".ansible/**",
      ".git/**",
      ".venv/**",
      "venv/**",
      "**/.terragrunt-cache/**",
      "**/node_modules/**"
    ]
  }
}
